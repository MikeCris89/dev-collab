{
	"compilerOptions": {
		"baseUrl": ".",
		// "paths": {
		// 	"@contract": ["../contract/types.js"],
		// 	"@contract/*": ["../contract"]
		// },
		// "verbatimModuleSyntax": true,

		"rootDirs": ["./src", "../contract"],
		"outDir": "./dist",
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"esModuleInterop": true,

		"sourceMap": true,
		"declaration": true,
		"declarationMap": true,

		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"skipLibCheck": true
	},
	"include": ["src", "../contract/types"]
}
